<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0E2A33">
<title>Manifest — One Piece TCG</title>
<style>
:root{
  --ink:#0E2A33; --abyss:#071A20; --panel:#12343F;
  --paper:#E8E1D4; --brass:#C98A2E; --signal:#C4423A; --foam:#6FB3A8;
  --mono: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, monospace;
  --sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
*{box-sizing:border-box}
html,body{margin:0;background:var(--ink);color:var(--paper);font-family:var(--sans)}
body{padding-bottom:env(safe-area-inset-bottom)}
.wrap{max-width:620px;margin:0 auto;padding:14px 14px 40px}

/* header */
header{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;
  border-bottom:2px solid rgba(232,225,212,.16);padding-bottom:12px}
h1{margin:0;font-size:22px;letter-spacing:.2em;text-transform:uppercase;font-weight:600}
header .sub{font-size:10px;letter-spacing:.16em;text-transform:uppercase;
  color:rgba(232,225,212,.45);margin-top:6px}
.tot{text-align:right;flex:none}
.tot b{display:block;font-family:var(--mono);font-size:24px;color:var(--brass);line-height:1}
.tot span{font-size:10px;letter-spacing:.14em;text-transform:uppercase;
  color:rgba(232,225,212,.45)}
.tot #tValue{display:block;margin-top:2px;font-family:var(--mono);
  text-transform:none;letter-spacing:0;color:rgba(232,225,212,.6)}

/* tabs */
nav{display:flex;gap:6px;margin:14px 0}
nav button{flex:1;background:rgba(232,225,212,.07);color:rgba(232,225,212,.7);
  border:0;padding:11px;font:600 12px/1 var(--sans);letter-spacing:.12em;
  text-transform:uppercase;cursor:pointer}
nav button[aria-selected=true]{background:var(--brass);color:var(--abyss)}
nav button:focus-visible{outline:2px solid var(--foam);outline-offset:2px}

/* search */
.searchrow{display:flex;gap:6px}
input,select{font:inherit;background:rgba(232,225,212,.06);
  border:1px solid rgba(232,225,212,.2);color:var(--paper);padding:12px}
input:focus,select:focus{outline:2px solid var(--foam);outline-offset:-1px}
input::placeholder{color:rgba(232,225,212,.35)}
#q{flex:1;font-family:var(--mono);font-size:16px;text-transform:uppercase}
.searchrow button{background:var(--brass);color:var(--abyss);border:0;padding:0 16px;
  font:700 13px var(--sans);cursor:pointer}
#filter{flex:1}
.searchrow select{flex:none}

.tip{font-size:11.5px;color:rgba(232,225,212,.4);margin:8px 2px 0;line-height:1.5}
.filterrow{display:flex;flex-wrap:wrap;gap:6px;margin:10px 2px 0}
.filterrow select{flex:1 1 calc(50% - 6px);min-width:120px;padding:9px 8px;font-size:12.5px}
.sortrow{display:flex;align-items:center;gap:8px;margin:10px 2px 0}
.sortrow label{font-size:10px;letter-spacing:.14em;text-transform:uppercase;
  color:rgba(232,225,212,.45)}
.sortrow select{flex:none;padding:8px 10px;font-size:13px}

/* result rows */
.row{display:flex;align-items:center;gap:10px;padding:9px 2px;
  border-bottom:1px solid rgba(232,225,212,.1)}
.row img{width:40px;height:56px;object-fit:cover;background:var(--abyss);flex:none}
.row .meta{flex:1;min-width:0}
.row .cid{font-family:var(--mono);font-size:11.5px;color:var(--brass);font-weight:700}
.row .nm{font-size:14px;margin-top:2px;overflow:hidden;text-overflow:ellipsis;
  white-space:nowrap}
.row .tags{font-family:var(--mono);font-size:10px;text-transform:uppercase;
  letter-spacing:.06em;color:rgba(232,225,212,.4);margin-top:3px}
.row .tags .price,.modal .price{color:var(--brass);font-weight:700}
.row .own{font-family:var(--mono);font-weight:700;font-size:18px;min-width:34px;
  text-align:right}
.row .own.zero{color:rgba(232,225,212,.25)}
.row .meta{cursor:pointer}
.row.leaderrow{cursor:pointer}
.row .btns{display:flex;gap:4px;flex:none}
.row .btns button{background:rgba(232,225,212,.1);color:var(--paper);border:0;
  font-family:var(--mono);font-size:14px;padding:7px 11px;cursor:pointer}
.row .btns button:hover{background:rgba(232,225,212,.22)}
.row .btns .minus:hover{background:var(--signal)}
.row img{cursor:pointer}
@keyframes flash{from{background:rgba(201,138,46,.3)}to{background:transparent}}
.row.hit{animation:flash .9s ease-out}

/* card detail modal */
.modal-backdrop{position:fixed;inset:0;background:rgba(7,26,32,.78);
  display:flex;align-items:flex-end;justify-content:center;z-index:50;
  animation:fadein .15s ease-out}
@keyframes fadein{from{opacity:0}to{opacity:1}}
@media (min-width:640px){.modal-backdrop{align-items:center}}
.modal{background:var(--paper);color:var(--abyss);width:100%;max-width:480px;
  max-height:92vh;overflow-y:auto;padding:18px 18px calc(18px + env(safe-area-inset-bottom))}
@media (min-width:640px){.modal{max-height:86vh}}
.modal-top{display:flex;justify-content:flex-end}
.modal-close{background:transparent;border:0;color:rgba(7,26,32,.5);font-size:22px;
  line-height:1;cursor:pointer;padding:2px 6px}
.modal-close:hover{color:var(--abyss)}
.modal img{display:block;width:100%;max-width:280px;margin:0 auto 14px;
  background:#ccc;object-fit:contain;cursor:zoom-in}

/* full-screen art zoom, opened by tapping the image inside the modal */
.zoom-backdrop{position:fixed;inset:0;background:rgba(7,26,32,.94);z-index:60;
  display:flex;align-items:center;justify-content:center;padding:18px;
  animation:fadein .12s ease-out}
.zoom-backdrop img{max-width:100%;max-height:100%;object-fit:contain;cursor:zoom-out}
.modal .cid{font-family:var(--mono);font-weight:700;color:var(--signal);
  border:2px solid var(--signal);display:inline-block;padding:2px 7px;font-size:13px}
.modal h2{margin:10px 0 4px;font-size:21px;line-height:1.2}
.modal .tagrow{display:flex;flex-wrap:wrap;gap:5px;margin:8px 0}
.modal .tagrow span{font-family:var(--mono);font-size:10.5px;text-transform:uppercase;
  letter-spacing:.05em;background:rgba(7,26,32,.08);padding:4px 8px}
.modal .stats{display:flex;gap:14px;margin:12px 0;font-family:var(--mono)}
.modal .stats div{text-align:center}
.modal .stats b{display:block;font-size:19px}
.modal .stats span{font-size:9.5px;text-transform:uppercase;letter-spacing:.1em;
  color:rgba(7,26,32,.5)}
.modal .effect{font-size:13.5px;line-height:1.55;color:rgba(7,26,32,.85);
  white-space:pre-line;margin:12px 0}
.modal .act{display:flex;gap:6px;align-items:center;margin-top:16px;
  padding-top:14px;border-top:1px solid rgba(7,26,32,.15)}
.modal .act button{background:var(--abyss);color:var(--paper);border:0;
  padding:10px 15px;font:700 14px var(--sans);cursor:pointer}
.modal .act .stepper{background:#D8CFBE;color:var(--abyss);font-family:var(--mono);
  padding:10px 14px}
.modal .act .n{font-family:var(--mono);font-weight:700;font-size:19px;min-width:30px;
  text-align:center}
.modal .act .own{margin-left:auto;font-family:var(--mono);font-size:12px;
  color:rgba(7,26,32,.55)}

.empty{padding:26px 2px;color:rgba(232,225,212,.42);font-size:14px;line-height:1.55}

/* scan panel */
/* Portrait, not landscape — a card is taller than it is wide, and so is a
   phone held normally to photograph one. */
.finder{position:relative;aspect-ratio:4/5;background:var(--abyss);display:grid;
  place-items:center;margin-top:12px;overflow:hidden}
.finder video{width:100%;height:100%;object-fit:cover}
.bk{position:absolute;width:30px;height:30px;border:2px solid var(--brass)}
.bk.tl{top:9px;left:9px;border-right:0;border-bottom:0}
.bk.tr{top:9px;right:9px;border-left:0;border-bottom:0}
.bk.bl{bottom:9px;left:9px;border-right:0;border-top:0}
.bk.br{bottom:9px;right:9px;border-left:0;border-top:0}
.guide{position:absolute;right:10%;bottom:3%;width:30%;height:7%;
  border:2px dashed var(--foam);border-radius:2px;pointer-events:none;
  display:flex;align-items:flex-start;justify-content:center}
.guide span{transform:translateY(-118%);font-family:var(--mono);font-size:9px;
  letter-spacing:.1em;text-transform:uppercase;color:var(--foam);
  text-shadow:0 1px 3px rgba(0,0,0,.9);white-space:nowrap}
.finder .msg{padding:22px;text-align:center;font-size:13px;line-height:1.55;
  color:rgba(232,225,212,.55)}
.scanbtns{display:flex;gap:6px;margin-top:8px}
.scanbtns button{flex:1;background:var(--brass);color:var(--abyss);border:0;
  padding:13px;font:700 13px var(--sans);cursor:pointer}
.scanbtns button.ghost{background:transparent;color:rgba(232,225,212,.8);
  border:1px solid rgba(232,225,212,.25)}
button:disabled{opacity:.45;cursor:default}

.status{font-family:var(--mono);font-size:12px;color:var(--foam);min-height:18px;
  margin-top:10px}
.status.err{color:#E8917F}

.card-hit{background:var(--paper);color:var(--abyss);padding:14px;margin-top:10px;
  display:flex;gap:12px}
.card-hit img{width:74px;height:104px;object-fit:cover;background:#ccc;flex:none}
.card-hit .cid{font-family:var(--mono);font-weight:700;color:var(--signal);
  border:2px solid var(--signal);display:inline-block;padding:2px 7px;font-size:13px}
.card-hit h3{margin:8px 0 4px;font-size:18px;line-height:1.15}
.card-hit .sm{font-family:var(--mono);font-size:11px;text-transform:uppercase;
  color:rgba(7,26,32,.6)}
.card-hit .warn{font-size:12px;color:#8A3A20;margin-top:7px;line-height:1.4}
.card-hit .act{display:flex;gap:6px;align-items:center;margin-top:11px}
.card-hit .act button{background:var(--abyss);color:var(--paper);border:0;
  padding:9px 14px;font:700 13px var(--sans);cursor:pointer}
.card-hit .act .stepper{background:#D8CFBE;color:var(--abyss);font-family:var(--mono);
  padding:9px 12px}
.card-hit .act .n{font-family:var(--mono);font-weight:700;font-size:17px;min-width:26px;
  text-align:center}

/* footer tools */
.tools{display:flex;gap:6px;margin-top:20px;flex-wrap:wrap}
.tools a,.tools button{flex:1;min-width:130px;text-align:center;text-decoration:none;
  background:transparent;border:1px solid rgba(232,225,212,.25);
  color:rgba(232,225,212,.8);padding:11px;font:600 12px/1.2 var(--sans);cursor:pointer}
.setgrid{margin-top:16px;font-family:var(--mono);font-size:11.5px;
  color:rgba(232,225,212,.55);line-height:1.9}
.setgrid span{color:var(--brass)}
.foot{margin-top:22px;padding-top:12px;border-top:1px solid rgba(232,225,212,.12);
  font-size:11.5px;line-height:1.6;color:rgba(232,225,212,.38)}

/* deck building */
button.ghost{background:transparent;border:1px solid rgba(232,225,212,.25);
  color:rgba(232,225,212,.8);padding:10px 14px;font:600 12px/1.2 var(--sans);cursor:pointer}
.backBtn{margin-bottom:12px}

.deckcard{display:flex;gap:12px;align-items:center;padding:12px;margin-top:8px;
  background:rgba(232,225,212,.05);border:1px solid rgba(232,225,212,.12);cursor:pointer}
.deckcard img{width:52px;height:73px;object-fit:cover;background:var(--abyss);flex:none}
.deckcard .meta{flex:1;min-width:0}
.deckcard h4{margin:0 0 3px;font-size:15px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.deckcard .sm{font-family:var(--mono);font-size:11px;color:rgba(232,225,212,.5)}
.deckcard .count{font-family:var(--mono);font-weight:700;font-size:15px;flex:none;text-align:right}
.deckcard .count span{display:block;font-size:9px;font-weight:400;text-transform:uppercase;
  letter-spacing:.08em;color:rgba(232,225,212,.4)}
.deckcard .count.ok b{color:var(--foam)}

.deckHead{display:flex;gap:12px;align-items:center;margin-top:14px;
  background:rgba(232,225,212,.05);padding:12px;border:1px solid rgba(232,225,212,.12)}
.deckHead img{width:64px;height:89px;object-fit:cover;background:var(--abyss);flex:none;cursor:pointer}
.deckHead .meta{flex:1;min-width:0}
.deckHead input.deckName{width:100%;background:transparent;border:0;
  border-bottom:1px solid rgba(232,225,212,.25);color:var(--paper);
  font:700 16px var(--sans);padding:4px 2px 6px;margin-bottom:2px}
.deckHead .stat{font-family:var(--mono);font-size:11px;color:rgba(232,225,212,.5);margin-top:3px}
.deckHead .stat b{color:var(--brass)}
.deckHead .stat.bad b{color:var(--signal)}
.deckHead .rowbtns{display:flex;gap:6px;margin-top:8px}
.deckHead button.ghost{padding:6px 10px;font-size:11px}

.deckLegal{margin-top:10px;padding:10px 12px;font-size:12.5px;line-height:1.5}
.deckLegal.ok{background:rgba(111,179,168,.12);color:var(--foam);border:1px solid rgba(111,179,168,.3)}
.deckLegal.bad{background:rgba(196,66,58,.12);color:#E8917F;border:1px solid rgba(196,66,58,.3)}
.deckLegal ul{margin:5px 0 0;padding-left:18px}

.deckGuide{margin-top:16px}
.curve{display:flex;align-items:flex-end;gap:3px;height:84px;margin-top:8px;
  border-bottom:1px solid rgba(232,225,212,.15);padding-bottom:2px}
.curve .col{flex:1;display:flex;flex-direction:column;align-items:center;
  justify-content:flex-end;height:100%;min-width:0}
.curve .bar{width:100%;background:var(--brass);min-height:2px}
.curve .n{font-family:var(--mono);font-size:9px;color:rgba(232,225,212,.55);margin-bottom:2px}
.curveRow{display:flex;gap:3px;margin-top:3px}
.curveRow .col{flex:1;text-align:center}
.curveRow .lbl{font-family:var(--mono);font-size:9px;color:rgba(232,225,212,.4)}
.guideGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:6px;margin-top:12px}
.guidePill{background:rgba(232,225,212,.05);padding:8px 10px;font-size:11.5px}
.guidePill b{display:block;font-family:var(--mono);font-size:16px;line-height:1.3}
.guidePill span{font-size:9.5px;text-transform:uppercase;letter-spacing:.07em;
  color:rgba(232,225,212,.45)}
.guidePill.ok b{color:var(--foam)}
.guidePill.low b{color:var(--signal)}
.guidePill.high b{color:var(--brass)}
.guideNote{font-size:10.5px;color:rgba(232,225,212,.35);margin-top:8px;line-height:1.5}

.deckSection{margin-top:22px}
.deckSection h3{font-size:12px;letter-spacing:.1em;text-transform:uppercase;
  color:rgba(232,225,212,.6);margin:0 0 8px;display:flex;align-items:baseline;
  gap:8px;flex-wrap:wrap}
.deckSection h3 .sm{font-family:var(--mono);font-size:10.5px;text-transform:none;
  letter-spacing:0;color:rgba(232,225,212,.4);font-weight:400}

.badge{display:inline-block;font-family:var(--mono);font-size:9px;text-transform:uppercase;
  letter-spacing:.05em;padding:2px 6px;margin-left:6px;vertical-align:1px;white-space:nowrap}
.badge.not-owned{background:rgba(196,66,58,.18);color:#E8917F}
.badge.owned{background:rgba(111,179,168,.16);color:var(--foam)}
.badge.illegal{background:rgba(201,138,46,.22);color:var(--brass)}

/* deck workspace: preview panel + two card grids, Master-Duel-style */
.wrap.wide{max-width:620px}   /* overridden wider at the desktop breakpoint below */
.deckWorkspace{display:flex;flex-direction:column;gap:22px;margin-top:18px}
.deckGridPanel h3,.addGridPanel h3{margin-bottom:2px}

.cgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(72px,1fr));
  gap:8px;margin-top:8px}
.ctile{position:relative;cursor:pointer;aspect-ratio:63/88;background:var(--abyss);
  overflow:hidden}
.ctile img{width:100%;height:100%;object-fit:cover;display:block}
.ctile.selected{outline:2px solid var(--brass);outline-offset:-2px}
.ctile.illegal{outline:2px solid var(--signal);outline-offset:-2px}
.ctile .pill{position:absolute;font-family:var(--mono);font-weight:700;font-size:10px;
  line-height:1.6;padding:0 4px;min-width:15px;text-align:center}
.ctile .owncount{top:3px;left:3px;background:rgba(7,26,32,.82)}
.ctile .owncount.zero{color:#E8917F}
.ctile .owncount:not(.zero){color:var(--foam)}
.ctile .deckcount{bottom:3px;right:3px;background:var(--brass);color:var(--abyss)}

.previewPanel{background:rgba(232,225,212,.05);border:1px solid rgba(232,225,212,.12);
  padding:14px}
.previewPanel .empty{padding:20px 4px;text-align:center}
.previewPanel img{display:block;width:100%;max-width:200px;margin:0 auto 10px;
  background:var(--abyss);object-fit:contain;cursor:zoom-in}
.previewPanel .cid{font-family:var(--mono);font-weight:700;color:var(--signal);
  border:2px solid var(--signal);display:inline-block;padding:2px 7px;font-size:12px}
.previewPanel h4{margin:8px 0 4px;font-size:16px;line-height:1.2}
.previewPanel .tagrow{display:flex;flex-wrap:wrap;gap:5px;margin:7px 0}
.previewPanel .tagrow span{font-family:var(--mono);font-size:10px;text-transform:uppercase;
  letter-spacing:.04em;background:rgba(232,225,212,.08);padding:3px 7px}
.previewPanel .pstats{display:flex;gap:14px;margin:10px 0;font-family:var(--mono);
  flex-wrap:wrap}
.previewPanel .pstats div{text-align:center}
.previewPanel .pstats b{display:block;font-size:16px}
.previewPanel .pstats span{font-size:9px;text-transform:uppercase;letter-spacing:.06em;
  color:rgba(232,225,212,.5)}
.previewPanel .effect{font-size:12px;line-height:1.55;color:rgba(232,225,212,.75);
  max-height:160px;overflow-y:auto;margin:10px 0;white-space:pre-line}
.previewPanel .pown{display:flex;justify-content:space-between;font-family:var(--mono);
  font-size:11px;color:rgba(232,225,212,.55);margin-top:10px;padding-top:10px;
  border-top:1px solid rgba(232,225,212,.12)}
.previewPanel .pown b{color:var(--paper)}
.previewPanel .pqty{display:flex;align-items:center;justify-content:center;gap:14px;
  margin-top:10px}
.previewPanel .pqty button{background:rgba(232,225,212,.1);color:var(--paper);border:0;
  font-family:var(--mono);font-size:16px;padding:8px 16px;cursor:pointer}
.previewPanel .pqty button:hover{background:rgba(232,225,212,.22)}
.previewPanel .pqty .n{font-family:var(--mono);font-weight:700;font-size:19px;
  min-width:26px;text-align:center}

@media (min-width:900px){
  .wrap.wide{max-width:1180px}
  .deckWorkspace{display:grid;grid-template-columns:230px 1fr 380px;gap:16px;
    align-items:start}
  .previewPanel{position:sticky;top:16px;max-height:calc(100vh - 32px);overflow-y:auto}
  .deckGridPanel,.addGridPanel{max-height:calc(100vh - 32px);overflow-y:auto;
    padding-right:2px}
  .cgrid{grid-template-columns:repeat(auto-fill,minmax(84px,1fr))}
}

.buyrow{display:flex;align-items:center;gap:10px;padding:8px 2px;
  border-bottom:1px solid rgba(232,225,212,.08);font-size:13px}
.buyrow img{width:32px;height:45px;object-fit:cover;background:var(--abyss);flex:none}
.buyrow .meta{flex:1;min-width:0}
.buyrow .meta .nm{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.buyrow .meta .sm{font-family:var(--mono);font-size:10.5px;color:rgba(232,225,212,.45)}
.buyrow .price{font-family:var(--mono);font-weight:700;color:var(--brass);
  text-align:right;flex:none;font-size:13px}
.buyrow .price .need{display:block;font-size:9.5px;font-weight:400;
  color:rgba(232,225,212,.45);text-transform:uppercase}

@media (prefers-reduced-motion:reduce){*{animation:none!important}}
</style>
</head>
<body>
<div class="wrap">

<header>
  <div>
    <h1>Manifest</h1>
    <div class="sub">One Piece TCG · self-hosted</div>
  </div>
  <div class="tot"><b id="tTotal">0</b><span id="tUniq">0 unique</span><span id="tValue"></span></div>
</header>

<nav role="tablist">
  <button id="tabLog"  role="tab" aria-selected="true">Log cards</button>
  <button id="tabOwn"  role="tab" aria-selected="false">My cards</button>
  <button id="tabDeck" role="tab" aria-selected="false">Decks</button>
  <button id="tabScan" role="tab" aria-selected="false">Scan</button>
</nav>

<!-- LOG -->
<section id="paneLog">
  <div class="searchrow">
    <input id="q" placeholder="OP01-016 or Nami" autocomplete="off"
           autocapitalize="characters" spellcheck="false">
    <button id="qGo">+1</button>
  </div>
  <p class="tip">Type a number and press Enter to log one copy. Or search a name and tap +
     on the right printing. Tap a card itself for the full picture and effect text.
     Alt arts are listed separately. Leave the search box empty and use the filters
     below to browse by type, colour, set or rarity.</p>
  <div class="filterrow">
    <select id="fCategory" aria-label="Filter by type">
      <option value="">All types</option>
    </select>
    <select id="fColor" aria-label="Filter by colour">
      <option value="">All colours</option>
    </select>
    <select id="fSet" aria-label="Filter by set">
      <option value="">All sets</option>
    </select>
    <select id="fRarity" aria-label="Filter by rarity">
      <option value="">All rarities</option>
    </select>
  </div>
  <div class="sortrow">
    <label for="sortResults">Sort</label>
    <select id="sortResults" aria-label="Sort by">
      <option value="number">Number</option>
      <option value="colors">Colour</option>
      <option value="set_label">Set</option>
      <option value="types">Subtype</option>
      <option value="price_gbp">Price (high–low)</option>
      <option value="qty">Owned first</option>
      <option value="not_owned">Not owned first</option>
    </select>
  </div>
  <div id="results"></div>
</section>

<!-- OWNED -->
<section id="paneOwn" hidden>
  <div class="searchrow">
    <input id="filter" placeholder="Filter what you own" autocomplete="off">
  </div>
  <div class="filterrow">
    <select id="fCategoryOwn" aria-label="Filter by type">
      <option value="">All types</option>
    </select>
    <select id="fColorOwn" aria-label="Filter by colour">
      <option value="">All colours</option>
    </select>
    <select id="fSetOwn" aria-label="Filter by set">
      <option value="">All sets</option>
    </select>
    <select id="fRarityOwn" aria-label="Filter by rarity">
      <option value="">All rarities</option>
    </select>
  </div>
  <div class="sortrow">
    <label for="sortOwned">Sort</label>
    <select id="sortOwned" aria-label="Sort by">
      <option value="number">Number</option>
      <option value="colors">Colour</option>
      <option value="set_label">Set</option>
      <option value="types">Subtype</option>
      <option value="price_gbp">Price (high–low)</option>
      <option value="qty">Qty (high–low)</option>
    </select>
  </div>
  <div id="owned"></div>
  <div class="setgrid" id="setBreak"></div>
  <div class="tools">
    <a href="/api/export.csv" download>Export CSV</a>
    <button id="btnReset">Clear everything</button>
  </div>
</section>

<!-- DECK -->
<section id="paneDeck" hidden>

  <div id="deckListView">
    <p class="tip">Pick a Leader to start a deck. The card list locks to your Leader's
       colours, and the curve/composition guide below tells you if you're on target.</p>
    <div class="tools" style="margin-top:0"><button id="btnNewDeck">+ New deck</button></div>
    <div id="deckList"></div>
  </div>

  <div id="deckLeaderPick" hidden>
    <button class="ghost backBtn" id="btnLeaderPickBack">&larr; Back</button>
    <div class="searchrow">
      <input id="qLeader" placeholder="Search leaders by name" autocomplete="off"
             autocapitalize="characters" spellcheck="false">
    </div>
    <div class="filterrow">
      <select id="fColorLeader" aria-label="Filter by colour"><option value="">All colours</option></select>
      <select id="fOwnedLeader" aria-label="Filter by ownership">
        <option value="">Owned + not owned</option>
        <option value="1">Owned only</option>
        <option value="0">Not owned only</option>
      </select>
    </div>
    <div id="leaderResults"></div>
  </div>

  <div id="deckEditView" hidden>
    <button class="ghost backBtn" id="btnDeckBack">&larr; All decks</button>
    <div class="deckHead" id="deckHead"></div>
    <div class="deckLegal" id="deckLegal"></div>
    <div class="deckGuide" id="deckGuide"></div>

    <div class="deckWorkspace">
      <div class="previewPanel" id="previewPanel">
        <div class="empty">Tap (or hover, on desktop) a card to preview it here.</div>
      </div>

      <div class="deckGridPanel">
        <h3>In this deck <span class="sm" id="deckCardsCount"></span></h3>
        <p class="tip">Tap a card to remove one copy. Numbers: top = owned, bottom = in deck.</p>
        <div class="cgrid" id="deckCardsGrid"></div>
      </div>

      <div class="addGridPanel">
        <h3>Add cards <span class="sm" id="deckColorNote"></span></h3>
        <div class="searchrow">
          <input id="qDeck" placeholder="Search by name or number" autocomplete="off"
                 autocapitalize="characters" spellcheck="false">
        </div>
        <div class="filterrow">
          <select id="fCategoryDeck" aria-label="Filter by type">
            <option value="">All types</option>
            <option value="Character">Character</option>
            <option value="Event">Event</option>
            <option value="Stage">Stage</option>
          </select>
          <select id="fSetDeck" aria-label="Filter by set"><option value="">All sets</option></select>
          <select id="fRarityDeck" aria-label="Filter by rarity"><option value="">All rarities</option></select>
          <select id="fOwnedDeck" aria-label="Filter by ownership">
            <option value="">Owned + not owned</option>
            <option value="1">Owned only</option>
            <option value="0">Not owned only</option>
          </select>
        </div>
        <div class="sortrow">
          <label for="sortDeckBrowse">Sort</label>
          <select id="sortDeckBrowse" aria-label="Sort by">
            <option value="number">Number</option>
            <option value="colors">Colour</option>
            <option value="set_label">Set</option>
            <option value="price_gbp">Price (high–low)</option>
            <option value="qty">Owned first</option>
            <option value="not_owned">Not owned first</option>
          </select>
        </div>
        <p class="tip">Tap a card to add one copy.</p>
        <div class="cgrid" id="deckBrowseGrid"></div>
      </div>
    </div>

    <div class="deckSection">
      <h3>Shopping list <span class="sm" id="buyTotal"></span></h3>
      <p class="tip" id="buyTip">Cards you don't own enough of yet, priced at current market.</p>
      <div id="buyList"></div>
    </div>

    <button id="btnDeckDelete" class="ghost" style="width:100%;margin-top:16px">Delete this deck</button>
  </div>

</section>

<!-- SCAN -->
<section id="paneScan" hidden>
  <div class="finder" id="finder">
    <div class="msg" id="finderMsg">Tap <b>Photo</b> below — it opens your camera app
      and works right now, no setup needed. <b>Zoom or move in close so the bottom-right
      corner alone fills the frame</b> — just the number, not the rest of the card —
      it reads far more reliably that way. <b>Live camera</b> is optional and needs a
      one-time HTTPS setup on this network.</div>
    <video id="video" playsinline muted hidden></video>
    <div class="bk tl"></div><div class="bk tr"></div>
    <div class="bk bl"></div><div class="bk br"></div>
    <div class="guide" id="guide"><span>card number here</span></div>
  </div>
  <div class="scanbtns">
    <button id="btnFile">Photo</button>
    <button class="ghost" id="btnCam">Live camera</button>
    <button class="ghost" id="btnShoot" disabled>Read card</button>
    <input type="file" id="file" accept="image/*" capture="environment" hidden>
  </div>
  <div class="status" id="status"></div>
  <div id="hit"></div>
</section>

<p class="foot" id="foot"></p>
</div>

<div id="modalHost"></div>

<script>
const $ = s => document.querySelector(s);
async function api(p, o) {
  try {
    const r = await fetch(p, o);
    if (!r.ok) throw new Error('HTTP ' + r.status);
    return await r.json();
  } catch (e) {
    if (e.name !== 'AbortError') say('Lost contact with the server. Is it still running?', true);
    throw e;
  }
}
let stream = null, pending = null, pendQty = 1, lastHit = null, USE_API = false;
let cardIndex = {};
const indexCards = list => list.forEach(c => cardIndex[c.card_id] = c);

/* ---------- filter dropdowns ----------
   Options come from /api/facets (distinct values straight from the catalogue)
   so a new set or rarity shows up automatically after a catalogue refresh,
   rather than needing this file edited too. Category/colour/rarity get a
   fixed, game-meaningful order up front; anything unrecognised is appended
   alphabetically so nothing new silently goes missing. */
const CATEGORY_ORDER = ['Leader', 'Character', 'Event', 'Stage'];
const COLOR_ORDER = ['Red', 'Green', 'Blue', 'Purple', 'Black', 'Yellow'];
const RARITY_ORDER = ['Common', 'Uncommon', 'Rare', 'SuperRare', 'SecretRare',
  'TreasureRare', 'Special', 'Leader', 'Promo'];
// Older catalogue snapshots stored these as shouty abbreviations (LEADER, SR,
// SEC, UC...) rather than the current scraper's full words — label lookups
// are keyed lowercase and matched case-insensitively so either vintage of
// manifest.db renders the same tidy dropdowns.
const RARITY_LABEL = {
  common: 'Common', c: 'Common', uncommon: 'Uncommon', uc: 'Uncommon',
  rare: 'Rare', r: 'Rare', superrare: 'Super Rare', sr: 'Super Rare',
  secretrare: 'Secret Rare', sec: 'Secret Rare', treasurerare: 'Treasure Rare',
  tr: 'Treasure Rare', special: 'Special', 'sp card': 'Special',
  leader: 'Leader', l: 'Leader', promo: 'Promo', p: 'Promo',
};
const titleCase = s => s.replace(/\w\S*/g,
  w => w[0].toUpperCase() + w.slice(1).toLowerCase());
function orderBy(values, order) {
  const rank = v => {
    const i = order.findIndex(o => o.toLowerCase() === v.toLowerCase());
    return i === -1 ? order.length : i;
  };
  return [...values].sort((a, b) => rank(a) - rank(b) || a.localeCompare(b));
}
function fillSelect(sel, values, labelFor) {
  values.forEach(v => {
    const o = document.createElement('option');
    o.value = v;
    o.textContent = labelFor ? (labelFor[v.toLowerCase()] || v) : titleCase(v);
    sel.appendChild(o);
  });
}
async function loadFacets() {
  const f = await api('/api/facets');
  const cats = orderBy(f.categories, CATEGORY_ORDER);
  const colors = orderBy(f.colors, COLOR_ORDER);
  const rarities = orderBy(f.rarities, RARITY_ORDER);
  ['fCategory', 'fCategoryOwn'].forEach(id => fillSelect($('#'+id), cats));
  ['fColor', 'fColorOwn', 'fColorLeader'].forEach(id => fillSelect($('#'+id), colors));
  ['fSet', 'fSetOwn', 'fSetDeck'].forEach(id => fillSelect($('#'+id), f.sets));
  ['fRarity', 'fRarityOwn', 'fRarityDeck'].forEach(id => fillSelect($('#'+id), rarities, RARITY_LABEL));
}
loadFacets().catch(() => {});

// suffix '' reads the Log tab's selects (fCategory, fColor, ...); 'Own' reads
// the My cards tab's (fCategoryOwn, fColorOwn, ...) — same four filters, two
// independent sets of controls since both panes exist in the DOM at once.
function readFilters(suffix) {
  return {
    category: $('#fCategory' + suffix).value,
    color: $('#fColor' + suffix).value,
    set: $('#fSet' + suffix).value,
    rarity: $('#fRarity' + suffix).value,
  };
}

/* ---------- tabs ---------- */
const panes = {tabLog:'paneLog', tabOwn:'paneOwn', tabDeck:'paneDeck', tabScan:'paneScan'};
Object.keys(panes).forEach(t => $('#'+t).onclick = () => {
  Object.entries(panes).forEach(([k,v]) => {
    $('#'+k).setAttribute('aria-selected', k===t);
    $('#'+v).hidden = k!==t;
  });
  if (t==='tabOwn') loadOwned();
  if (t==='tabDeck') showDeckList();
  if (t==='tabLog') $('#q').focus();
  if (t!=='tabScan') stopCam();
});

/* ---------- shared row renderer ---------- */
const esc = s => String(s ?? '').replace(/[&<>"']/g, m =>
  ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));

// 'number' is the order the server already sends (by card_id) - every other
// key is a plain alphabetical group, with card_id as a stable tiebreaker so
// same-valued rows (e.g. every card of one colour) don't jump around between
// re-renders. price_gbp/qty are numeric instead, highest first, with cards
// that have no price yet (price_gbp is null) sinking to the bottom rather
// than sorting as if they were worth £0. not_owned is the same qty field but
// ascending, so the cards you have zero of float to the top instead.
const sortCollator = new Intl.Collator(undefined, {numeric: true, sensitivity: 'base'});
const NUMERIC_SORT_KEYS = ['price_gbp', 'qty'];
function sortCards(list, key) {
  if (key === 'number') return list;
  if (NUMERIC_SORT_KEYS.includes(key)) {
    const num = c => (c[key] === null || c[key] === undefined) ? -Infinity : Number(c[key]);
    return [...list].sort((a, b) =>
      num(b) - num(a) || sortCollator.compare(a.card_id, b.card_id));
  }
  if (key === 'not_owned') {
    const num = c => (c.qty === null || c.qty === undefined) ? Infinity : Number(c.qty);
    return [...list].sort((a, b) =>
      num(a) - num(b) || sortCollator.compare(a.card_id, b.card_id));
  }
  return [...list].sort((a, b) =>
    sortCollator.compare(a[key] || '', b[key] || '') ||
    sortCollator.compare(a.card_id, b.card_id));
}

// Prices come from an unofficial, free API (optcgapi.com) and are refreshed
// by running refresh_prices.py on a schedule, not live per-request — a card
// with no price yet just shows nothing rather than a placeholder.
const fmtGBP = v => (v || v === 0) ? '£' + v.toFixed(2) : '';

function rowHTML(c, qty) {
  const tags = [c.set_label, c.rarity, c.variant, c.colors].filter(Boolean).join(' · ');
  const price = fmtGBP(c.price_gbp);
  return `<div class="row ${c.card_id===lastHit?'hit':''}" data-id="${esc(c.card_id)}">
    <img loading="lazy" alt="" src="/img/${encodeURIComponent(c.card_id)}"
         onerror="this.style.visibility='hidden'">
    <div class="meta">
      <div class="cid">${esc(c.card_id)}</div>
      <div class="nm">${esc(c.name || 'Not in catalogue')}</div>
      <div class="tags">${esc(tags)}${price ? ` · <span class="price">${price}</span>` : ''}</div>
    </div>
    <div class="own ${qty?'':'zero'}">${qty||0}</div>
    <div class="btns">
      <button class="minus" data-d="-1" aria-label="One fewer">−</button>
      <button data-d="1" aria-label="One more">+</button>
    </div>
  </div>`;
}

function wire(host, after) {
  host.querySelectorAll('.row .btns button').forEach(b => b.onclick = async () => {
    const id = b.closest('.row').dataset.id;
    const r = await api('/api/collection', {method:'POST',
      headers:{'content-type':'application/json'},
      body: JSON.stringify({card_id:id, delta:+b.dataset.d})});
    lastHit = id;
    refreshTotals();
    after(r);
  });
  host.querySelectorAll('.row').forEach(row => {
    row.onclick = e => {
      if (e.target.closest('.btns')) return;
      const c = cardIndex[row.dataset.id];
      if (c) openCardModal(c);
    };
  });
}

/* ---------- card detail modal ---------- */
function cardModalHTML(c) {
  const tags = [c.set_label, c.rarity, c.variant].filter(Boolean);
  const stats = [];
  // A Leader isn't played from hand, so it has no DON cost — the site's own
  // markup puts the Leader's Life value in that same slot, and the scraper
  // (and this app's catalog.cost column) carries it through as-is.
  if (c.cost !== null && c.cost !== undefined && c.cost !== '')
    stats.push([(c.category || '').toUpperCase() === 'LEADER' ? 'life' : 'cost', c.cost]);
  if (c.power) stats.push(['power', c.power]);
  if (c.counter) stats.push(['counter', c.counter]);
  const price = fmtGBP(c.price_gbp);
  if (price) stats.push(['market', price]);
  const extra = [c.colors, c.types, c.category].filter(Boolean);
  return `<div class="modal-backdrop" id="modalBackdrop">
    <div class="modal" role="dialog" aria-modal="true" aria-label="${esc(c.name || c.card_id)}">
      <div class="modal-top"><button class="modal-close" id="modalClose" aria-label="Close">&times;</button></div>
      <img alt="" src="/img/${encodeURIComponent(c.card_id)}" onerror="this.style.visibility='hidden'">
      <span class="cid">${esc(c.card_id)}</span>
      <h2>${esc(c.name || 'Not in catalogue')}</h2>
      ${tags.length ? `<div class="tagrow">${tags.map(t=>`<span>${esc(t)}</span>`).join('')}</div>` : ''}
      ${stats.length ? `<div class="stats">${stats.map(([k,v])=>
        `<div><b>${esc(v)}</b><span>${k}</span></div>`).join('')}</div>` : ''}
      ${extra.length ? `<div class="tagrow">${extra.map(t=>`<span>${esc(t)}</span>`).join('')}</div>` : ''}
      ${c.effect ? `<div class="effect">${esc(c.effect)}</div>` : ''}
      <div class="act">
        <button class="stepper" id="modalMinus" aria-label="One fewer">−</button>
        <span class="n" id="modalQty">${c.qty || 0}</span>
        <button class="stepper" id="modalPlus" aria-label="One more">+</button>
        <span class="own">owned</span>
      </div>
    </div>
  </div>`;
}

function openCardModal(c) {
  const host = $('#modalHost');
  host.innerHTML = cardModalHTML(c);
  const backdrop = $('#modalBackdrop');
  const onKey = e => { if (e.key === 'Escape') close(); };
  function close() { host.innerHTML = ''; document.removeEventListener('keydown', onKey); }
  backdrop.onclick = e => { if (e.target === backdrop) close(); };
  $('#modalClose').onclick = close;
  document.addEventListener('keydown', onKey);

  const img = backdrop.querySelector('.modal img');
  if (img) img.onclick = () => openImageZoom(img.src, c.name || c.card_id);

  const step = async d => {
    const r = await api('/api/collection', {method:'POST',
      headers:{'content-type':'application/json'},
      body: JSON.stringify({card_id: c.card_id, delta: d})});
    c.qty = r.qty;
    $('#modalQty').textContent = r.qty;
    lastHit = c.card_id;
    refreshTotals();
    syncRowQty(c.card_id, r.qty);
  };
  $('#modalMinus').onclick = () => step(-1);
  $('#modalPlus').onclick = () => step(1);

  // The list view leaves out effect text to keep search fast; fetch it now
  // that the card is actually open, and slot it in without disturbing the
  // rest of the modal (or the user's scroll position).
  if (!c.effect) {
    api('/api/card/' + encodeURIComponent(c.card_id)).then(d => {
      const card = d && d.card;
      if (!card || !card.effect || !document.body.contains(backdrop)) return;
      c.effect = card.effect;
      const eff = document.createElement('div');
      eff.className = 'effect';
      eff.textContent = card.effect;
      backdrop.querySelector('.modal .act').before(eff);
    }).catch(() => {});
  }
}

function openImageZoom(src, label) {
  if (!src) return;
  const z = document.createElement('div');
  z.className = 'zoom-backdrop';
  z.innerHTML = `<img src="${src}" alt="${esc(label || '')}">`;
  z.onclick = () => z.remove();
  document.addEventListener('keydown', function onKey(e) {
    if (e.key === 'Escape') { z.remove(); document.removeEventListener('keydown', onKey); }
  });
  document.body.appendChild(z);
}

function syncRowQty(id, qty) {
  document.querySelectorAll(`.row[data-id="${CSS.escape(id)}"] .own`).forEach(el => {
    el.textContent = qty;
    el.classList.toggle('zero', !qty);
  });
}

/* ---------- log tab ---------- */
let timer = null;
$('#q').oninput = () => { clearTimeout(timer); timer = setTimeout(() => doSearch().catch(()=>{}), 120); };
$('#q').onkeydown = e => { if (e.key === 'Enter') quickAdd(); };
$('#qGo').onclick = quickAdd;

// Typing fast fires overlapping requests. Without this, a slow early response
// can land after a later, faster one and clobber it with stale results — the
// list looks like it's flickering/lagging behind what's typed. Aborting the
// previous in-flight request (and ignoring anything that isn't the latest)
// keeps only the newest query's results on screen.
let searchAbort = null;
async function doSearch() {
  const v = $('#q').value.trim();
  const fl = readFilters('');
  const filtersActive = fl.category || fl.color || fl.set || fl.rarity;
  if (searchAbort) searchAbort.abort();
  if (!v && !filtersActive) { $('#results').innerHTML = ''; return; }
  searchAbort = new AbortController();
  const mine = searchAbort;
  const params = new URLSearchParams({q: v});
  if (fl.category) params.set('category', fl.category);
  if (fl.color) params.set('color', fl.color);
  if (fl.set) params.set('set', fl.set);
  if (fl.rarity) params.set('rarity', fl.rarity);
  // Typing narrows fast, so the default 40-row cap is plenty there; browsing
  // by filter alone (no text) can legitimately span hundreds of cards.
  if (!v && filtersActive) params.set('limit', '500');
  let data;
  try {
    data = await api('/api/search?' + params.toString(), {signal: mine.signal});
  } catch (e) {
    if (e.name === 'AbortError') return;
    throw e;
  }
  if (mine !== searchAbort) return; // a newer search started while this one was in flight
  render(data.results);
}
['fCategory', 'fColor', 'fSet', 'fRarity'].forEach(id =>
  $('#' + id).onchange = () => doSearch().catch(() => {}));

let lastResults = [];
$('#sortResults').onchange = () => render(lastResults);

function render(results) {
  lastResults = results;
  const host = $('#results');
  if (!results.length) {
    host.innerHTML = `<div class="empty">Nothing matches that. Newer sets may not be in
      the catalogue yet — you can still log the number and it will count.</div>`;
    return;
  }
  const list = sortCards(results, $('#sortResults').value);
  host.innerHTML = list.map(c => rowHTML(c, c.qty)).join('');
  indexCards(list);
  wire(host, () => doSearch());
  lastHit = null;
}

async function quickAdd() {
  const v = $('#q').value.trim();
  if (!v) return;
  const {results} = await api('/api/search?q=' + encodeURIComponent(v) + '&limit=2');
  // A bare card number that resolves to exactly one printing logs straight away.
  if (results.length && /^[A-Za-z]{2,3}\d{2}-\d{3}/.test(v.replace(/\s/g,''))) {
    const r = await api('/api/collection', {method:'POST',
      headers:{'content-type':'application/json'},
      body: JSON.stringify({card_id: results[0].card_id, delta: 1})});
    lastHit = r.card_id;
    $('#q').value = '';
    $('#results').innerHTML = '';
    flash(`${r.card_id} — ${r.name || 'logged'} ×${r.qty}`);
    refreshTotals();
    return;
  }
  doSearch();
}

function flash(msg) {
  const host = $('#results');
  host.innerHTML = `<div class="empty" style="color:var(--foam)">${esc(msg)}</div>`;
  setTimeout(() => { if (host.firstChild && !$('#q').value) host.innerHTML = ''; }, 2200);
}

/* ---------- owned tab ---------- */
let owned = [];
async function loadOwned() {
  const d = await api('/api/collection');
  owned = d.cards;
  paintOwned();
  $('#setBreak').innerHTML = d.stats.sets.map(s =>
    `${esc(s.s || '—')} <span>${s.n}</span> cards · ${s.uniq}/${s.total} of the set`
  ).join('<br>');
}
$('#filter').oninput = paintOwned;
$('#sortOwned').onchange = paintOwned;
['fCategoryOwn', 'fColorOwn', 'fSetOwn', 'fRarityOwn'].forEach(id =>
  $('#' + id).onchange = paintOwned);

function paintOwned() {
  const f = $('#filter').value.trim().toLowerCase();
  const fl = readFilters('Own');
  let list = owned.filter(c =>
    (!f || c.card_id.toLowerCase().includes(f) || (c.name||'').toLowerCase().includes(f)) &&
    (!fl.category || c.category === fl.category) &&
    (!fl.color || (c.colors || '').includes(fl.color)) &&
    (!fl.set || c.set_label === fl.set) &&
    (!fl.rarity || c.rarity === fl.rarity));
  const host = $('#owned');
  if (!list.length) {
    host.innerHTML = `<div class="empty">${owned.length
      ? 'Nothing matches that filter.'
      : 'Nothing logged yet. Head to Log cards and type a number.'}</div>`;
    return;
  }
  list = sortCards(list, $('#sortOwned').value);
  host.innerHTML = list.map(c => rowHTML(c, c.qty)).join('');
  indexCards(list);
  wire(host, () => loadOwned());
}

$('#btnReset').onclick = async () => {
  if (!confirm('Delete every logged card? This cannot be undone.')) return;
  await api('/api/reset', {method:'POST',
    headers:{'content-type':'application/json'}, body: '{}'});
  loadOwned(); refreshTotals();
};

/* ---------- deck building ----------
   Legality (50 cards, 4-copy cap, leader colour match) and the guideline
   bands (curve/composition targets) are computed server-side in
   deck_detail() - this is display-only. See server.py for where the target
   numbers come from. */
let decks = [];
let currentDeck = null;
let leaderPickMode = 'new';    // 'new' while starting a deck, 'change' while swapping leaders
let lastLeaderResults = [];
let lastDeckBrowse = [];

function showDeckSub(id) {
  ['deckListView', 'deckLeaderPick', 'deckEditView'].forEach(v => $('#'+v).hidden = v !== id);
  // The workspace (preview panel + two card grids) wants real width on a
  // desktop screen - everywhere else in the app stays the narrow, phone-first
  // column, so only widen while the editor with the grids is actually open.
  document.querySelector('.wrap').classList.toggle('wide', id === 'deckEditView');
}

async function showDeckList() {
  showDeckSub('deckListView');
  currentDeck = null;
  const r = await api('/api/decks');
  decks = r.decks;
  renderDeckList();
}

function renderDeckList() {
  const host = $('#deckList');
  if (!decks.length) {
    host.innerHTML = `<div class="empty">No decks yet. Tap "+ New deck" and pick a Leader to start.</div>`;
    return;
  }
  host.innerHTML = decks.map(d => {
    const leader = d.leader || {};
    return `<div class="deckcard" data-id="${d.id}">
      <img loading="lazy" alt="" src="/img/${encodeURIComponent(leader.card_id||'')}"
           onerror="this.style.visibility='hidden'">
      <div class="meta">
        <h4>${esc(d.name)}</h4>
        <div class="sm">${esc(leader.name || 'No leader')}${leader.colors ? ' · ' + esc(leader.colors) : ''}</div>
      </div>
      <div class="count ${d.size_ok ? 'ok' : ''}"><b>${d.card_count}</b><span>of 50</span></div>
    </div>`;
  }).join('');
  host.querySelectorAll('.deckcard').forEach(el =>
    el.onclick = () => openDeck(Number(el.dataset.id)));
}

$('#btnNewDeck').onclick = () => { leaderPickMode = 'new'; openLeaderPicker(); };

/* ---- leader picker (used both for a new deck and "change leader") ---- */
function openLeaderPicker() {
  showDeckSub('deckLeaderPick');
  $('#qLeader').value = '';
  $('#fColorLeader').value = '';
  $('#fOwnedLeader').value = '';
  doLeaderSearch().catch(() => {});
  $('#qLeader').focus();
}
$('#btnLeaderPickBack').onclick = () => {
  if (leaderPickMode === 'change' && currentDeck) { showDeckSub('deckEditView'); }
  else { showDeckList(); }
};

let leaderTimer = null;
$('#qLeader').oninput = () => { clearTimeout(leaderTimer);
  leaderTimer = setTimeout(() => doLeaderSearch().catch(() => {}), 120); };
$('#fColorLeader').onchange = () => doLeaderSearch().catch(() => {});
$('#fOwnedLeader').onchange = () => doLeaderSearch().catch(() => {});

let leaderSearchAbort = null;
async function doLeaderSearch() {
  const v = $('#qLeader').value.trim();
  const color = $('#fColorLeader').value;
  const owned = $('#fOwnedLeader').value;   // '' = both, '1' = owned only, '0' = not-owned only
  if (leaderSearchAbort) leaderSearchAbort.abort();
  leaderSearchAbort = new AbortController();
  const mine = leaderSearchAbort;
  const params = new URLSearchParams({q: v, category: 'Leader', limit: '500'});
  if (color) params.set('color', color);
  if (owned === '1') params.set('owned', '1');   // "not owned" has no server-side filter; done below
  let data;
  try {
    data = await api('/api/search?' + params.toString(), {signal: mine.signal});
  } catch (e) {
    if (e.name === 'AbortError') return;
    throw e;
  }
  if (mine !== leaderSearchAbort) return;
  if (owned === '0') data.results = data.results.filter(c => !c.qty);
  renderLeaderResults(data.results);
}

function renderLeaderResults(results) {
  lastLeaderResults = results;
  const host = $('#leaderResults');
  if (!results.length) {
    host.innerHTML = `<div class="empty">No leaders match.</div>`;
    return;
  }
  host.innerHTML = results.map(c => {
    const badge = c.qty > 0 ? `<span class="badge owned">owned ${c.qty}</span>`
                            : `<span class="badge not-owned">not owned</span>`;
    return `<div class="row leaderrow" data-id="${esc(c.card_id)}">
    <img loading="lazy" alt="" src="/img/${encodeURIComponent(c.card_id)}"
         onerror="this.style.visibility='hidden'">
    <div class="meta">
      <div class="cid">${esc(c.card_id)}</div>
      <div class="nm">${esc(c.name)}${badge}</div>
      <div class="tags">${esc([c.colors, c.cost != null ? 'Life ' + c.cost : '',
        c.power ? 'Power ' + c.power : ''].filter(Boolean).join(' · '))}</div>
    </div>
  </div>`;
  }).join('');
  host.querySelectorAll('.leaderrow').forEach(row =>
    row.onclick = () => pickLeader(row.dataset.id));
}

async function pickLeader(cardId) {
  const c = lastLeaderResults.find(x => x.card_id === cardId);
  if (leaderPickMode === 'new') {
    const r = await api('/api/decks', {method: 'POST',
      headers: {'content-type': 'application/json'},
      body: JSON.stringify({name: (c && c.name ? c.name : 'New deck') + ' Deck',
                            leader_card_id: cardId})});
    currentDeck = r.deck;
  } else {
    const r = await api(`/api/decks/${currentDeck.id}`, {method: 'POST',
      headers: {'content-type': 'application/json'},
      body: JSON.stringify({leader_card_id: cardId})});
    currentDeck = r.deck;
  }
  showDeckSub('deckEditView');
  renderDeckEditor();
}

/* ---- deck editor ---- */
async function openDeck(id) {
  const r = await api('/api/decks/' + id);
  currentDeck = r.deck;
  showDeckSub('deckEditView');
  renderDeckEditor();
}
$('#btnDeckBack').onclick = showDeckList;

function renderDeckEditor() {
  previewedCard = null;
  $('#previewPanel').innerHTML =
    `<div class="empty">Tap (or hover, on desktop) a card to preview it here.</div>`;
  renderDeckHead();
  renderDeckLegal();
  renderDeckGuide();
  renderDeckCards();
  $('#deckColorNote').textContent = currentDeck.leader
    ? `locked to ${currentDeck.leader.colors}` : '';
  renderBuyList();
  doDeckSearch().catch(() => {});
}

function renderDeckHead() {
  const d = currentDeck, leader = d.leader;
  $('#deckHead').innerHTML = leader ? `
    <img alt="" src="/img/${encodeURIComponent(leader.card_id)}" id="deckLeaderImg"
         onerror="this.style.visibility='hidden'">
    <div class="meta">
      <input class="deckName" id="deckNameInput" value="${esc(d.name)}" aria-label="Deck name">
      <div class="stat">${esc(leader.name)} · ${esc(leader.colors)} · Life ${leader.life ?? '—'}</div>
      <div class="stat ${d.legal.size_ok ? '' : 'bad'}"><b>${d.total}</b> / ${d.deck_size_target} cards</div>
      <div class="rowbtns"><button class="ghost" id="btnChangeLeader">Change leader</button></div>
    </div>` : '';
  if (!leader) return;
  $('#deckLeaderImg').onclick = async () => {
    const r = await api('/api/card/' + encodeURIComponent(leader.card_id));
    if (r.card) openCardModal(r.card);
  };
  const nameInput = $('#deckNameInput');
  nameInput.onchange = async () => {
    const r = await api(`/api/decks/${d.id}`, {method: 'POST',
      headers: {'content-type': 'application/json'},
      body: JSON.stringify({name: nameInput.value})});
    currentDeck = r.deck;
  };
  $('#btnChangeLeader').onclick = () => { leaderPickMode = 'change'; openLeaderPicker(); };
}

function renderDeckLegal() {
  const d = currentDeck, host = $('#deckLegal');
  const nameOfBase = baseId => {
    const c = d.cards.find(x => x.base_id === baseId);
    return c ? c.name : baseId;
  };
  const nameOfCard = cardId => {
    const c = d.cards.find(x => x.card_id === cardId);
    return c ? c.name : cardId;
  };
  if (d.legal.clean) {
    host.className = 'deckLegal ok';
    host.textContent = "Legal: exactly 50 cards, nothing over 4 copies, "
      + "everything matches your Leader's colours.";
    return;
  }
  host.className = 'deckLegal bad';
  const issues = [];
  if (!d.legal.size_ok) {
    issues.push(d.legal.short_by > 0
      ? `${d.legal.short_by} more card${d.legal.short_by === 1 ? '' : 's'} needed (${d.total}/${d.deck_size_target})`
      : `${d.legal.over_by} too many cards (${d.total}/${d.deck_size_target})`);
  }
  if (d.legal.over_limit.length)
    issues.push('Over the 4-copy limit: ' + d.legal.over_limit.map(nameOfBase).join(', '));
  if (d.legal.off_color.length)
    issues.push("Doesn't match your Leader's colours: " + d.legal.off_color.map(nameOfCard).join(', '));
  host.innerHTML = 'Not tournament-legal yet:<ul>'
    + issues.map(i => `<li>${esc(i)}</li>`).join('') + '</ul>';
}

function guidePill(label, g) {
  return `<div class="guidePill ${g.band}"><b>${g.count}</b>
    <span>${esc(label)} · target ${g.min}–${g.max}</span></div>`;
}

function renderDeckGuide() {
  const d = currentDeck, curve = d.curve;
  const costs = Array.from({length: 11}, (_, i) => i); // 0..10, 10 catching "10+"
  const max = Math.max(1, ...costs.map(c => curve[String(c)] || 0));
  const bars = costs.map(c => {
    const n = curve[String(c)] || 0;
    const h = Math.round(n / max * 100);
    return `<div class="col"><div class="n">${n || ''}</div><div class="bar" style="height:${h}%"></div></div>`;
  }).join('');
  const labels = costs.map(c => `<div class="col"><div class="lbl">${c === 10 ? '10+' : c}</div></div>`).join('');
  $('#deckGuide').innerHTML = `
    <h3>Cost curve</h3>
    <div class="curve">${bars}</div>
    <div class="curveRow">${labels}</div>
    <div class="guideGrid">
      ${guidePill('Characters', d.guidelines.characters)}
      ${guidePill('Events', d.guidelines.events)}
      ${guidePill('Stages', d.guidelines.stages)}
      ${guidePill('Counter cards', d.guidelines.counters)}
      ${guidePill('Blockers', d.guidelines.blockers)}
      ${guidePill('Low cost 0-3', d.guidelines.cost_low)}
      ${guidePill('Mid cost 4-6', d.guidelines.cost_mid)}
      ${guidePill('High cost 7+', d.guidelines.cost_high)}
    </div>
    <div class="guideNote">Targets are community deckbuilding starting points, not an
      official rule — a deck outside these ranges is still perfectly legal.</div>`;
}

/* ---- card tiles + the hover/tap preview panel ----
   Tapping a tile in the "add" grid adds one copy and previews it; tapping a
   tile in the "in this deck" grid removes one copy and previews it. Hovering
   (desktop only - touch has no hover) just previews, without changing
   anything, so you can look before you commit. The preview panel always
   re-fetches the full card record (effect text isn't in the cheap search
   payload) and is the single source of truth for the +/- buttons too, so
   there's only one place that needs to agree with the server about quantity. */
let previewedCard = null;
let previewHoverTimer = null;
let previewAbort = null;

function deckQtyOf(cardId) {
  const e = currentDeck.cards.find(x => x.card_id === cardId);
  return e ? e.qty : 0;
}

function tileHTML(c, ownedQty, deckQty, illegal) {
  const ownedCls = ownedQty > 0 ? '' : 'zero';
  return `<div class="ctile${illegal ? ' illegal' : ''}" data-id="${esc(c.card_id)}"
       title="${esc(c.name || c.card_id)}">
    <img loading="lazy" alt="" src="/img/${encodeURIComponent(c.card_id)}"
         onerror="this.style.visibility='hidden'">
    <span class="pill owncount ${ownedCls}">${ownedQty}</span>
    ${deckQty ? `<span class="pill deckcount">${deckQty}</span>` : ''}
  </div>`;
}

function wireTiles(host, mode) {   // mode: 'add' (+1 per tap) or 'remove' (-1 per tap)
  host.querySelectorAll('.ctile').forEach(tile => {
    const id = tile.dataset.id;
    tile.onclick = async () => {
      const cur = deckQtyOf(id);
      const next = mode === 'add' ? cur + 1 : Math.max(0, cur - 1);
      await setDeckCardQty(id, next);
      loadPreview(id).catch(() => {});
    };
    tile.onmouseenter = () => hoverPreview(id);
  });
}

function hoverPreview(cardId) {
  clearTimeout(previewHoverTimer);
  previewHoverTimer = setTimeout(() => loadPreview(cardId).catch(() => {}), 90);
}

async function loadPreview(cardId) {
  if (previewAbort) previewAbort.abort();
  previewAbort = new AbortController();
  const mine = previewAbort;
  let data;
  try {
    data = await api('/api/card/' + encodeURIComponent(cardId), {signal: mine.signal});
  } catch (e) {
    if (e.name === 'AbortError') return;
    throw e;
  }
  if (mine !== previewAbort) return;
  if (data.card) renderPreview(data.card);
}

function renderPreview(c) {
  previewedCard = c;
  const deckQty = deckQtyOf(c.card_id);
  const isLeader = (c.category || '').toUpperCase() === 'LEADER';
  const tags = [c.set_label, c.rarity, c.variant].filter(Boolean);
  const stats = [];
  if (c.cost !== null && c.cost !== undefined && c.cost !== '')
    stats.push([isLeader ? 'life' : 'cost', c.cost]);
  if (c.power) stats.push(['power', c.power]);
  if (c.counter) stats.push(['counter', c.counter]);
  const price = fmtGBP(c.price_gbp);
  $('#previewPanel').innerHTML = `
    <img alt="" src="/img/${encodeURIComponent(c.card_id)}" id="previewImg"
         onerror="this.style.visibility='hidden'">
    <span class="cid">${esc(c.card_id)}</span>
    <h4>${esc(c.name || 'Not in catalogue')}</h4>
    ${tags.length ? `<div class="tagrow">${tags.map(t => `<span>${esc(t)}</span>`).join('')}</div>` : ''}
    ${(stats.length || price) ? `<div class="pstats">${stats.map(([k, v]) =>
      `<div><b>${esc(v)}</b><span>${esc(k)}</span></div>`).join('')}${price ?
      `<div><b>${price}</b><span>market</span></div>` : ''}</div>` : ''}
    ${c.effect ? `<div class="effect">${esc(c.effect)}</div>` : ''}
    <div class="pown"><span>Owned <b>${c.qty || 0}</b></span><span>In deck <b>${deckQty}</b></span></div>
    ${!isLeader ? `<div class="pqty">
      <button id="previewMinus" aria-label="One fewer">−</button>
      <span class="n">${deckQty}</span>
      <button id="previewPlus" aria-label="One more">+</button>
    </div>` : ''}`;
  const img = $('#previewImg');
  if (img) img.onclick = () => openImageZoom(img.src, c.name || c.card_id);
  const bump = async d => {
    await setDeckCardQty(c.card_id, Math.max(0, deckQtyOf(c.card_id) + d));
    loadPreview(c.card_id).catch(() => {});
  };
  const minus = $('#previewMinus'), plus = $('#previewPlus');
  if (minus) minus.onclick = () => bump(-1);
  if (plus) plus.onclick = () => bump(1);
  document.querySelectorAll('.ctile').forEach(t =>
    t.classList.toggle('selected', t.dataset.id === c.card_id));
}

function renderDeckCards() {
  const d = currentDeck;
  $('#deckCardsCount').textContent = `${d.total} / ${d.deck_size_target}`;
  const host = $('#deckCardsGrid');
  if (!d.cards.length) {
    host.innerHTML = `<div class="empty">No cards yet — add some from the list on the right.</div>`;
    return;
  }
  const overBase = new Set(d.legal.over_limit);
  const offColor = new Set(d.legal.off_color);
  host.innerHTML = d.cards.map(c =>
    tileHTML(c, c.owned_qty, c.qty, overBase.has(c.base_id) || offColor.has(c.card_id))).join('');
  wireTiles(host, 'remove');
}

async function setDeckCardQty(cardId, qty) {
  const r = await api(`/api/decks/${currentDeck.id}/card`, {method: 'POST',
    headers: {'content-type': 'application/json'}, body: JSON.stringify({card_id: cardId, qty})});
  currentDeck = r.deck;
  renderDeckHead(); renderDeckLegal(); renderDeckGuide(); renderDeckCards(); renderBuyList();
  if (lastDeckBrowse.length) renderDeckBrowse(lastDeckBrowse);
}

/* ---- add-cards browser, locked to the leader's colour(s) ---- */
let deckTimer = null;
$('#qDeck').oninput = () => { clearTimeout(deckTimer);
  deckTimer = setTimeout(() => doDeckSearch().catch(() => {}), 120); };
['fCategoryDeck', 'fSetDeck', 'fRarityDeck', 'fOwnedDeck'].forEach(id =>
  $('#' + id).onchange = () => doDeckSearch().catch(() => {}));

let deckBrowseAbort = null;
async function doDeckSearch() {
  if (!currentDeck || !currentDeck.leader) { $('#deckBrowseGrid').innerHTML = ''; return; }
  const v = $('#qDeck').value.trim();
  const category = $('#fCategoryDeck').value;
  const set = $('#fSetDeck').value;
  const rarity = $('#fRarityDeck').value;
  const owned = $('#fOwnedDeck').value;   // '' = both, '1' = owned only, '0' = not-owned only
  if (deckBrowseAbort) deckBrowseAbort.abort();
  deckBrowseAbort = new AbortController();
  const mine = deckBrowseAbort;
  const params = new URLSearchParams({q: v, limit: '500'});
  if (category) params.set('category', category);
  if (set) params.set('set', set);
  if (rarity) params.set('rarity', rarity);
  if (owned === '1') params.set('owned', '1');   // the server can filter "owned"; "not owned" is done below
  let data;
  try {
    data = await api('/api/search?' + params.toString(), {signal: mine.signal});
  } catch (e) {
    if (e.name === 'AbortError') return;
    throw e;
  }
  if (mine !== deckBrowseAbort) return;
  if (owned === '0') data.results = data.results.filter(c => !c.qty);
  // The server can filter to one colour at a time; a dual-colour Leader
  // needs "shares any colour with the Leader", so that half is done here.
  const leaderColors = new Set((currentDeck.leader.colors || '')
    .split(',').map(s => s.trim()).filter(Boolean));
  const results = data.results.filter(c => (c.category || '').toUpperCase() !== 'LEADER' &&
    (c.colors || '').split(',').map(s => s.trim()).some(col => leaderColors.has(col)));
  renderDeckBrowse(results);
}

function renderDeckBrowse(results) {
  lastDeckBrowse = results;
  const host = $('#deckBrowseGrid');
  if (!results.length) {
    host.innerHTML = `<div class="empty">Nothing matches, in your Leader's colours.</div>`;
    return;
  }
  const list = sortCards(results, $('#sortDeckBrowse').value);
  host.innerHTML = list.map(c => tileHTML(c, c.qty, deckQtyOf(c.card_id), false)).join('');
  wireTiles(host, 'add');
}
$('#sortDeckBrowse').onchange = () => renderDeckBrowse(lastDeckBrowse);

function renderBuyList() {
  const d = currentDeck;
  const cardTotal = d.buy_list.reduce((s, b) => s + b.need, 0);
  $('#buyTotal').textContent = d.buy_list.length
    ? `${cardTotal} card${cardTotal === 1 ? '' : 's'} · ${fmtGBP(d.buy_total_gbp) || 'price unknown'}`
    : '';
  const host = $('#buyList');
  if (!d.buy_list.length) {
    host.innerHTML = `<div class="empty">${d.cards.length
      ? 'You own enough of everything in this deck.'
      : 'Add cards above to see what you still need to buy.'}</div>`;
    return;
  }
  host.innerHTML = d.buy_list.map(b => `<div class="buyrow">
    <img loading="lazy" alt="" src="/img/${encodeURIComponent(b.card_id)}" onerror="this.style.visibility='hidden'">
    <div class="meta">
      <div class="nm">${esc(b.name || b.card_id)}</div>
      <div class="sm">${esc([b.card_id, b.set_label, b.rarity].filter(Boolean).join(' · '))}</div>
    </div>
    <div class="price">${b.subtotal_gbp != null ? fmtGBP(b.subtotal_gbp) : '—'}
      <span class="need">need ${b.need}</span></div>
  </div>`).join('');
}

$('#btnDeckDelete').onclick = async () => {
  if (!currentDeck) return;
  if (!confirm(`Delete "${currentDeck.name}"? This can't be undone.`)) return;
  await api(`/api/decks/${currentDeck.id}/delete`, {method: 'POST',
    headers: {'content-type': 'application/json'}, body: '{}'});
  currentDeck = null;
  showDeckList();
};

/* ---------- scan tab ---------- */
const camConstraints = {
  // height, not width, is the *larger* dimension here — a card, and a
  // phone held normally to photograph one, are both portrait.
  video: {facingMode: {ideal: 'environment'}, height: {ideal: 1920}, aspectRatio: {ideal: 4/5}},
};

async function refocus() {
  if (!stream) return;
  const v = $('#video');
  const track = stream.getVideoTracks()[0];
  const caps = track.getCapabilities ? track.getCapabilities() : {};
  if (caps.focusMode && caps.focusMode.includes('single-shot')) {
    try { await track.applyConstraints({advanced: [{focusMode: 'single-shot'}]}); return; }
    catch (e) {}
  }
  // Most phone browsers don't actually expose focus control through
  // getCapabilities() — caps.focusMode comes back empty, so the "proper"
  // API above silently does nothing. The one lever that's still available
  // everywhere is that many phones re-run their own autofocus sweep when a
  // camera session first opens, even though nothing here can trigger that
  // sweep directly — so closing and reopening the stream is the fallback.
  say('Restarting the camera to refocus…');
  stream.getTracks().forEach(t => t.stop());
  try {
    stream = await navigator.mediaDevices.getUserMedia(camConstraints);
    v.srcObject = stream; await v.play();
    say('If the number still looks blurry, tap the preview again.');
  } catch (e) {
    say('Could not restart the camera.', true);
  }
}

$('#btnCam').onclick = async () => {
  try {
    stream = await navigator.mediaDevices.getUserMedia(camConstraints);
    const v = $('#video');
    v.srcObject = stream; await v.play();
    v.hidden = false; $('#finderMsg').hidden = true; $('#btnShoot').disabled = false;

    // The number is read from close up, well inside the distance most phone
    // cameras focus at by default for a live preview — some devices lock
    // focus on whatever was in frame when the stream opened and never
    // refocus after that. Ask for continuous autofocus if the device
    // exposes it, on top of the tap-to-refocus handler below.
    const track = stream.getVideoTracks()[0];
    const caps = track.getCapabilities ? track.getCapabilities() : {};
    if (caps.focusMode && caps.focusMode.includes('continuous')) {
      track.applyConstraints({advanced: [{focusMode: 'continuous'}]}).catch(() => {});
    }
    v.onclick = () => { refocus().catch(() => {}); };

    say('If the number looks blurry, tap the preview to refocus.');
  } catch (e) {
    if (!window.isSecureContext) {
      $('#finderMsg').innerHTML =
        'Live camera needs a secure page. <a href="/setup" style="color:#6FB3A8">' +
        'Set that up once</a> if you want it — or just use <b>Photo</b> above, which ' +
        'scans exactly the same and already works.';
      $('#finderMsg').hidden = false;
      say('Live camera needs HTTPS. Photo works right now instead.', true);
    } else {
      say('Camera permission was refused. Allow it in your browser settings, or use Photo.', true);
    }
  }
};
function stopCam() {
  if (stream) { stream.getTracks().forEach(t => t.stop()); stream = null; }
  $('#video').onclick = null;
  $('#video').hidden = true; $('#finderMsg').hidden = false; $('#btnShoot').disabled = true;
}
$('#btnShoot').onclick = async () => {
  const v = $('#video');
  if (!v.videoWidth) return say('Camera not ready.', true);
  // Freeze on the frame you actually meant to capture — otherwise the
  // preview keeps moving under your hand while it reads, so what gets
  // analysed is never quite the frame you were looking at when you tapped.
  v.pause();
  $('#btnShoot').disabled = true;
  try {
    // The crop math has to compensate for object-fit:cover cropping the
    // native camera frame down to what's actually on screen — but that
    // only works if it knows the box's real on-screen shape. This used to
    // assume the CSS aspect-ratio:5/4 on .finder had actually taken effect,
    // which isn't true on every browser; when it doesn't, the box renders
    // at some other shape (often whatever the raw camera stream is) and
    // every crop lands off-target. Measuring the video element's actual
    // rendered box is correct regardless of whether that CSS applied.
    const box = v.getBoundingClientRect();
    const containerAspect = box.width / box.height;
    await send(shrink(v, v.videoWidth, v.videoHeight),
               cornerVariants(v, v.videoWidth, v.videoHeight, containerAspect));
  } finally {
    $('#btnShoot').disabled = false;
    if (stream) v.play().catch(() => {});
  }
};
$('#btnFile').onclick = () => $('#file').click();
$('#file').onchange = e => {
  const f = e.target.files[0]; if (!f) return;
  const rd = new FileReader();
  rd.onload = () => { const i = new Image();
    i.onload = () => send(shrink(i, i.width, i.height),
                          cornerVariants(i, i.width, i.height)); i.src = rd.result; };
  rd.readAsDataURL(f); e.target.value = '';
};
function shrink(src, w, h) {
  const s = Math.min(1, 1200 / Math.max(w, h));
  const cv = document.createElement('canvas');
  cv.width = w*s|0; cv.height = h*s|0;
  cv.getContext('2d').drawImage(src, 0, 0, cv.width, cv.height);
  return cv.toDataURL('image/jpeg', .85).split(',')[1];
}

/* The card number sits in the bottom-right corner. Crop just that, blow it up,
   flatten it to grey and stretch the contrast — then hand the server a few
   versions so its OCR gets more than one shot. All of this runs here, so
   scanning costs nothing and works with no internet. */
function cornerVariants(src, w, h, containerAspect) {
  const GX = 0.60, GY = 0.90, GW = 0.30, GH = 0.07;   // matches the dashed box

  // The live preview is shown with object-fit:cover inside a fixed-aspect
  // box, which crops the native camera frame before the user ever sees it.
  // Apply that same crop here first, or the guide box on screen and the
  // region we actually read drift apart on any camera that isn't 5:4 native
  // (almost all of them). Not needed for an uploaded photo — that has no
  // container to be cropped against.
  let vx = 0, vy = 0, vw = w, vh = h;
  if (containerAspect) {
    const nativeAspect = w / h;
    if (nativeAspect > containerAspect) { vw = h * containerAspect; vx = (w - vw) / 2; }
    else                                { vh = w / containerAspect; vy = (h - vh) / 2; }
  }

  const boxAt = (cx0, cy0, cw, ch) =>
    ({sx: cx0 + cw*GX, sy: cy0 + ch*GY, sw: cw*GW, sh: ch*GH});

  let regions;
  if (containerAspect) {
    // Live camera has a dashed box the user lines the number up against,
    // but a hand-held phone rarely hits it pixel-perfect. Try the exact box
    // first, then a second, generously padded version of the same box as a
    // safety net for a near miss, instead of demanding perfect alignment.
    const exact = boxAt(vx, vy, vw, vh);
    const pad = 0.35;
    const padded = {
      sx: exact.sx - exact.sw*pad, sy: exact.sy - exact.sh*pad,
      sw: exact.sw*(1 + 2*pad),    sh: exact.sh*(1 + 2*pad),
    };
    // 'min' and 'chroma' are complementary, not interchangeable — light
    // text needs one and dark text needs the other (see the comment where
    // they're computed below). Splitting each region's attempts across
    // both, rather than committing a region to just one, covers either
    // colour of ink within the same fixed number of tries.
    regions = [
      {...exact,  configs: [[3,null,'min'],[4,null,'chroma'],[4,150,'min'],[3,140,'chroma']]},
      {...padded, configs: [[4,null,'min'],[4,150,'chroma']]},
    ];
  } else {
    // An uploaded photo has no on-screen guide: the card might fill the
    // whole frame if it was zoomed in as instructed, or it might be a
    // normal, more distant shot of the whole card with background around
    // it. Rather than assume one, try a few plausible sizes for how much
    // of the frame the card actually fills.
    regions = [1, 0.65, 0.42].map(fill => {
      const cw = vw*fill, ch = vh*fill;
      return {...boxAt(vx + (vw-cw)/2, vy + (vh-ch)/2, cw, ch),
              configs: [[4,null,'min'],[4,150,'chroma']]};
    });
  }

  const out = [];
  for (const {sx, sy, sw, sh, configs} of regions) {
    for (const [scale, thr, channel] of configs) {
    const cv = document.createElement('canvas');
    cv.width  = Math.min(2000, sw*scale|0);
    cv.height = Math.min(700,  sh*scale|0);
    const cx = cv.getContext('2d');
    cx.imageSmoothingEnabled = true;
    cx.imageSmoothingQuality = 'high';
    cx.drawImage(src, sx, sy, sw, sh, 0, 0, cv.width, cv.height);

    const d = cx.getImageData(0, 0, cv.width, cv.height);
    const p = d.data;
    // The card's background isn't flat — it's a fine dot/halftone texture —
    // so standard luminance (.299R+.587G+.114B) is no good here: it tracks
    // that texture right along with the text, because a saturated
    // background is still bright in whichever channel matches its own hue
    // (e.g. the red channel on a red card), and the dots survive the
    // contrast stretch as noise and bury the text under it. Most cards
    // print the number in white ink, which — unlike any single-hue
    // background — is bright in all three channels at once, so the
    // *minimum* of R,G,B is high only on the text. But some cards (yellow
    // ones especially) print it in black ink instead, which is dark in
    // every channel just like that background's weak channel is, so min()
    // can't tell them apart there — what actually separates black OR white
    // ink from a saturated background in that case is that ink is neutral
    // (R≈G≈B) while a card colour never is, so 255 minus the spread
    // between the channels (its "chroma") is high for either colour of
    // ink and low across the background regardless of its hue.
    for (let i = 0; i < p.length; i += 4) {
      const r = p[i], gr = p[i+1], b = p[i+2];
      const g = channel === 'chroma'
        ? 255 - (Math.max(r,gr,b) - Math.min(r,gr,b))
        : Math.min(r, gr, b);
      p[i] = p[i+1] = p[i+2] = g;
    }
    cx.putImageData(d, 0, 0);

    // A real photo is rarely lit evenly — a flash reflection or an angled
    // shadow makes one end of the crop brighter than the other. A single
    // global threshold then does the wrong thing on whichever end is off:
    // it either crushes dim-but-legible text to black or blows bright text
    // out to white. A blurred copy of the crop subtracted back out fixes
    // that in principle (the standard "flat-field" trick), but blur is a
    // trap here in practice: CSS/canvas `filter: blur()` quality varies a
    // lot across phone GPUs and can ring at the radius this needs, and a
    // plain scaled drawImage — even at 'high' smoothing quality — isn't
    // guaranteed to average every source pixel, so a regular texture
    // (a halftone dot pattern, fabric weave) can alias straight through
    // instead of blurring away. A least-squares plane fit sidesteps all of
    // that: it has only three degrees of freedom (tilt in x, tilt in y, and
    // an overall level), so there is no texture fine enough for it to
    // pick up — it can only ever describe the kind of slow, one-sided
    // brightness trend a flash or shadow actually produces.
    const xbar = (cv.width - 1) / 2, ybar = (cv.height - 1) / 2;
    let sxz = 0, syz = 0, sxx = 0, syy = 0;
    for (let y = 0, i = 0; y < cv.height; y++) {
      const yp = y - ybar;
      for (let x = 0; x < cv.width; x++, i += 4) {
        const xp = x - xbar, z = p[i];
        sxz += xp * z; syz += yp * z;
        sxx += xp * xp; syy += yp * yp;
      }
    }
    const a = sxx ? sxz / sxx : 0, bTilt = syy ? syz / syy : 0;

    let lo = 255, hi = 0;
    for (let y = 0, i = 0; y < cv.height; y++) {
      const yp = y - ybar;
      for (let x = 0; x < cv.width; x++, i += 4) {
        const xp = x - xbar;
        const g = Math.max(0, Math.min(255, p[i] - (a*xp + bTilt*yp)));
        p[i] = g;
        if (g < lo) lo = g;
        if (g > hi) hi = g;
      }
    }
    const span = Math.max(1, hi - lo);
    for (let i = 0; i < p.length; i += 4) {
      let g = ((p[i] - lo) * 255 / span) | 0;
      if (thr !== null) g = g > thr ? 255 : 0;
      p[i] = p[i+1] = p[i+2] = g; p[i+3] = 255;
    }
    cx.putImageData(d, 0, 0);
    out.push(cv.toDataURL('image/png').split(',')[1]);
    }
  }
  return out;
}

async function send(b64, variants) {
  say('Reading…'); $('#hit').innerHTML = '';
  const payload = {variants};
  if (USE_API) payload.image = b64;      // only sent when the API is the engine
  const r = await api('/api/scan', {method:'POST',
    headers:{'content-type':'application/json'}, body: JSON.stringify(payload)});
  if (!r.ok) return say(r.message || 'No read.', true);
  say('');
  pending = r; pendQty = 1;
  const c = r.card || {card_id:r.card_id, name:'Not in catalogue'};
  $('#hit').innerHTML = `<div class="card-hit">
    <img alt="" src="/img/${encodeURIComponent(r.card_id)}"
         onerror="this.style.visibility='hidden'">
    <div>
      <span class="cid">${esc(r.card_id)}</span>
      <h3>${esc(c.name || 'Not in catalogue')}</h3>
      <div class="sm">${esc([c.set_label,c.rarity,c.variant].filter(Boolean).join(' · '))}</div>
      ${(r.confidence==='low'||r.note) ? `<div class="warn">${esc(r.note||'Low confidence — check the number.')}</div>`:''}
      ${!r.in_catalog ? `<div class="warn">Not in the catalogue. It will still be counted under this number.</div>`:''}
      <div class="act">
        <button class="stepper" id="mns">−</button>
        <span class="n" id="pn">1</span>
        <button class="stepper" id="pls">+</button>
        <button id="logit">Log it</button>
      </div>
    </div></div>`;
  $('#mns').onclick = () => { pendQty = Math.max(1,pendQty-1); $('#pn').textContent = pendQty; };
  $('#pls').onclick = () => { pendQty++; $('#pn').textContent = pendQty; };
  $('#logit').onclick = async () => {
    const res = await api('/api/collection', {method:'POST',
      headers:{'content-type':'application/json'},
      body: JSON.stringify({card_id: pending.card_id, delta: pendQty})});
    $('#hit').innerHTML = '';
    say(`${res.card_id} logged — ${res.qty} total. Next card.`);
    refreshTotals();
  };
}
function say(m, err) {
  const s = $('#status'); if (!s) return;
  s.textContent = m; s.className = 'status' + (err ? ' err' : '');
}

/* ---------- totals ---------- */
async function refreshTotals() {
  const s = await api('/api/stats');
  $('#tTotal').textContent = s.total;
  $('#tUniq').textContent = s.unique + ' unique';
  $('#tValue').textContent = s.value_gbp ? fmtGBP(s.value_gbp) + ' market' : '';
}

(async () => {
  const h = await api('/api/health');
  USE_API = h.api_scanning && !h.ocr;
  const how = h.ocr ? 'reads card numbers on this machine, free'
            : h.api_scanning ? 'uses the API, which costs per scan'
            : 'off — install tesseract for free local scanning';
  $('#foot').textContent =
    `${h.catalog} printings in the local catalogue. Counts live in manifest.db on the ` +
    `machine running this. Scanning ${how}.`;
  if (!window.isSecureContext && h.scanning) {
    $('#finderMsg').innerHTML =
      'Tap <b>Photo</b> above to scan a card — it works on this connection right now. ' +
      'Zoom or move in close so just the bottom-right corner fills the frame; it reads ' +
      'far more reliably that way. <b>Live camera</b> needs a secure page; <a href="/setup" ' +
      'style="color:#6FB3A8">set that up once</a> only if you want the live viewfinder.';
  }
  if (!h.scanning) $('#finderMsg').innerHTML =
    'Scanning needs tesseract installed on the machine running this. ' +
    'See the README. Typing a number always works.';
  refreshTotals().catch(()=>{});
  $('#q').focus();
})().catch(()=>{});
</script>
</body>
</html>
