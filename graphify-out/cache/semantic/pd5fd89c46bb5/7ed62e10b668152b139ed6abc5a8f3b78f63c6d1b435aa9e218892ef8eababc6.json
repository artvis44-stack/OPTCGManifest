{"nodes": [{"id": "readme_manifest", "label": "Manifest (self-hosted OPTCG collection counter)", "file_type": "document", "source_file": "README.md", "source_location": "L1-5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_self_hosted_ownership", "label": "Self-hosted, no-account data ownership principle", "file_type": "rationale", "source_file": "README.md", "source_location": "L3-5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No accounts, no scan limits, no subscription; counts live in a SQLite file the user owns. Runs on one LAN machine, used from the phone."}, {"id": "readme_stdlib_only", "label": "Standard-library-only Python 3.8+ dependency policy", "file_type": "rationale", "source_file": "README.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No pip install required \u2014 everything is standard library, so the server starts on any machine with Python 3.8+ without a dependency step."}, {"id": "readme_server_py", "label": "server.py (HTTP server, SQLite, API)", "file_type": "code", "source_file": "README.md", "source_location": "L237", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ui_html", "label": "ui.html (the interface)", "file_type": "code", "source_file": "README.md", "source_location": "L238", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_catalog_json", "label": "catalog.json (card data seeded into the database)", "file_type": "document", "source_file": "README.md", "source_location": "L239", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_scrape_catalog_py", "label": "scrape_catalog.py (pull current card list from official site)", "file_type": "code", "source_file": "README.md", "source_location": "L240", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_refresh_catalog_py", "label": "refresh_catalog.py (fallback GitHub dataset re-pull)", "file_type": "code", "source_file": "README.md", "source_location": "L241", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept as the fallback for when the official site is unreachable or its markup changes."}, {"id": "readme_make_cert_sh", "label": "make_cert.sh (certificate authority and server certificate)", "file_type": "code", "source_file": "README.md", "source_location": "L242", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_cert_files", "label": "ca.pem / cert.pem / key.pem", "file_type": "document", "source_file": "README.md", "source_location": "L243", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_test_manifest_py", "label": "test_manifest.py (94-check test suite)", "file_type": "code", "source_file": "README.md", "source_location": "L220-231", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_manifest_db", "label": "manifest.db (single-file SQLite collection)", "file_type": "document", "source_file": "README.md", "source_location": "L150,L245", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single file so backup is just a copy."}, {"id": "readme_img_cache", "label": "img-cache/ (locally cached card art)", "file_type": "document", "source_file": "README.md", "source_location": "L129-142", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_art_proxy", "label": "Card art proxy and cache", "file_type": "concept", "source_file": "README.md", "source_location": "L129-142", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Images are proxied and cached rather than hotlinked because the official card site sends a Cross-Origin-Resource-Policy header that makes browsers refuse to render its images inside another page. Caching also makes art load instantly and work offline; art is treated as decoration so failures are non-fatal."}, {"id": "readme_path_traversal_guard", "label": "Art proxy path-traversal refusal", "file_type": "concept", "source_file": "README.md", "source_location": "L226", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_catalogue_seeding", "label": "Catalogue seeding on first run", "file_type": "concept", "source_file": "README.md", "source_location": "L22-23", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_reseed_flag", "label": "--reseed (rebuild catalogue from catalog.json)", "file_type": "concept", "source_file": "README.md", "source_location": "L167,L213", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_type_the_number", "label": "Log by typing the card number", "file_type": "concept", "source_file": "README.md", "source_location": "L29-31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fastest path for bulk: no focusing, no waiting, no misreads. Enter logs one copy and clears the box for the next card."}, {"id": "readme_search_by_name", "label": "Log by searching card name", "file_type": "concept", "source_file": "README.md", "source_location": "L33-35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used when the number is unreadable or the exact printing is uncertain; every printing comes back with its art."}, {"id": "readme_scan_a_photo", "label": "Log by scanning a photo", "file_type": "concept", "source_file": "README.md", "source_location": "L37,L43-80", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_alt_art_separation", "label": "Alternate arts tracked as separate entries", "file_type": "rationale", "source_file": "README.md", "source_location": "L39-41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OP01-016 and OP01-016_p1 are different rows with different images, because a parallel can be worth many times the base print and lumping them together loses exactly the information worth having."}, {"id": "readme_tesseract_ocr", "label": "Tesseract local OCR engine", "file_type": "concept", "source_file": "README.md", "source_location": "L45-61", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen because it is free, open-source and runs entirely on the user's machine: nothing uploaded, no key, no per-scan cost. Fedora packages it as `tesseract` with English training data separate, a common install pitfall."}, {"id": "readme_corner_crop_pipeline", "label": "Bottom-right corner crop and preprocessing pipeline", "file_type": "concept", "source_file": "README.md", "source_location": "L63-72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The phone crops the corner shown by the dashed viewfinder box, upscales, greyscales and contrast-stretches, then uploads several processed variants of a small crop \u2014 keeping the upload tiny and giving the OCR engine multiple chances. The dashed box is the crop region, so numbers outside it are unreadable by construction."}, {"id": "readme_ocr_character_correction", "label": "Fixed-position OCR character confusion repair", "file_type": "concept", "source_file": "README.md", "source_location": "L66-68", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Because letters and digits occupy fixed positions in a card number, common OCR slips can be corrected deterministically: 0P11-004 becomes OP11-004, EBO1-006 becomes EB01-006."}, {"id": "readme_ocr_failure_honesty", "label": "Fail-loud on low-contrast scans", "file_type": "rationale", "source_file": "README.md", "source_location": "L73-76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Low-contrast pale-on-pale numbers are the known failure mode; when it misses it reports why rather than guessing, because typing the number is an immediate fallback."}, {"id": "readme_claude_api_fallback", "label": "Optional Claude API scan fallback (ANTHROPIC_API_KEY)", "file_type": "concept", "source_file": "README.md", "source_location": "L78-80", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unreadable photos fall through to Claude for awkward cases. Strictly opt-in: with Tesseract installed the API is never called, so it costs nothing unless requested."}, {"id": "readme_live_viewfinder", "label": "Live camera viewfinder", "file_type": "concept", "source_file": "README.md", "source_location": "L82-98", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Browsers only grant camera access on a secure page and plain http:// on a LAN does not qualify; this is a browser rule the app cannot opt out of. The Photo button scans identically without HTTPS, so most users need not bother."}, {"id": "readme_https_mode", "label": "server.py --https (TLS mode)", "file_type": "concept", "source_file": "README.md", "source_location": "L93-96,L212", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_setup_page", "label": "/setup certificate-install helper page", "file_type": "concept", "source_file": "README.md", "source_location": "L98-109", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately served over plain http:// on the port one above the app, because the setup page is what installs the certificate \u2014 serving it over https:// would require the phone to trust the certificate before it could reach the page that installs it. The helper serves nothing but the certificate and instructions."}, {"id": "readme_local_ca", "label": "Local certificate authority signing a server certificate", "file_type": "concept", "source_file": "README.md", "source_location": "L111-119", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A bare self-signed certificate is no longer accepted by phones, so make_cert.sh mints a private CA and signs with it. The leaf is valid 397 days because Safari refuses anything over 398 with no click-through, and it carries extendedKeyUsage=serverAuth plus every machine address in subjectAltName because iOS 13+ rejects certificates lacking both."}, {"id": "readme_ios_trust_toggle", "label": "iOS Certificate Trust Settings toggle", "file_type": "concept", "source_file": "README.md", "source_location": "L121-123", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Installing the profile is only half the job on iPhone; the authority must additionally be enabled under Settings > General > About > Certificate Trust Settings."}, {"id": "readme_android_insecure_origin_flag", "label": "Android insecure-origin-as-secure Chrome flag", "file_type": "concept", "source_file": "README.md", "source_location": "L125-127", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Android can skip certificates entirely by whitelisting the http:// origin in chrome://flags/#unsafely-treat-insecure-origin-as-secure."}, {"id": "readme_csv_export", "label": "CSV export (/api/export.csv)", "file_type": "concept", "source_file": "README.md", "source_location": "L144-148", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Columns: card number, name, set, variant, rarity, colours, category, quantity, note, last updated. Plain CSV so it opens anywhere and can be pasted into a pricing service."}, {"id": "readme_health_endpoint", "label": "/api/health version endpoint", "file_type": "concept", "source_file": "README.md", "source_location": "L197-206", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reports version, catalogue printing count and scanning status; unknown paths return the supported route list so a missing /setup proves the file is older than the documentation."}, {"id": "readme_catalogue_coverage", "label": "Catalogue coverage: 2,627 printings to April 2025", "file_type": "concept", "source_file": "README.md", "source_location": "L152-161", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Covers OP-01..OP-10, EB-01, EB-02, PRB-01, ST-01..ST-21, promos and other-product cards. Sets after April 2025 (OP-11 onward) are absent but still countable \u2014 they just show without name or picture."}, {"id": "readme_vegapull_records", "label": "vegapull-records dataset (coko7/vegapull-records)", "file_type": "document", "source_file": "README.md", "source_location": "L155-157", "source_url": "https://github.com/coko7/vegapull-records", "captured_at": null, "author": null, "contributor": null}, {"id": "readme_official_card_site", "label": "en.onepiece-cardgame.com official card list", "file_type": "document", "source_file": "README.md", "source_location": "L140-141,L170", "source_url": "https://en.onepiece-cardgame.com", "captured_at": null, "author": null, "contributor": null}, {"id": "readme_polite_scraping", "label": "Polite scraping: one request per set with a pause", "file_type": "rationale", "source_file": "README.md", "source_location": "L170-173", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scraping the official site directly keeps data current with no third-party dataset in the way, but is deliberately throttled to one request per set with a pause because it is someone else's website."}, {"id": "readme_japanese_cards_excluded", "label": "Japanese-only cards deliberately excluded", "file_type": "rationale", "source_file": "README.md", "source_location": "L187-188", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The upstream dataset's Japanese file has known formatting problems, so it is left out rather than imported dirty."}, {"id": "readme_no_prices", "label": "No price data (out of scope)", "file_type": "rationale", "source_file": "README.md", "source_location": "L190-195", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TCGplayer and Cardmarket gate their pricing APIs behind approval and scraping them breaks on any page change; the tool counts what you own and hands you a CSV to feed a service that has proper price data."}, {"id": "readme_lan_binding_no_auth", "label": "Binds 0.0.0.0 with no login", "file_type": "rationale", "source_file": "README.md", "source_location": "L248-252", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anyone on the LAN can reach it and change counts, which is usually what you want on a home network; the accepted mitigation is simply never exposing the port to the internet. --host 127.0.0.1 restricts to this machine only."}, {"id": "readme_concurrent_write_clamping", "label": "Concurrent write handling and quantity clamping", "file_type": "concept", "source_file": "README.md", "source_location": "L223-226", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tested with 40 simultaneous writes landing correctly, plus survival across a restart and keep-alive connection reuse."}, {"id": "readme_cli_options", "label": "server.py CLI options (--port, --host, --https, --reseed, --verbose)", "file_type": "concept", "source_file": "README.md", "source_location": "L207-215", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_manifest", "target": "readme_server_py", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L10,L237", "weight": 1.0}, {"source": "readme_manifest", "target": "readme_ui_html", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L238", "weight": 1.0}, {"source": "readme_self_hosted_ownership", "target": "readme_manifest", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L3-5", "weight": 1.0}, {"source": "readme_self_hosted_ownership", "target": "readme_manifest_db", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L5,L150", "weight": 1.0}, {"source": "readme_stdlib_only", "target": "readme_server_py", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L13", "weight": 1.0}, {"source": "readme_server_py", "target": "readme_manifest_db", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L22-23,L237", "weight": 1.0}, {"source": "readme_server_py", "target": "readme_ui_html", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "L237-238", "weight": 1.0}, {"source": "readme_catalogue_seeding", "target": "readme_catalog_json", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L22-23,L239", "weight": 1.0}, {"source": "readme_catalogue_seeding", "target": "readme_manifest_db", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L22-23", "weight": 1.0}, {"source": "readme_server_py", "target": "readme_catalogue_seeding", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L22-23", "weight": 1.0}, {"source": "readme_reseed_flag", "target": "readme_catalog_json", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L213", "weight": 1.0}, {"source": "readme_reseed_flag", "target": "readme_catalogue_seeding", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L167,L213", "weight": 1.0}, {"source": "readme_scrape_catalog_py", "target": "readme_official_card_site", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L163-173", "weight": 1.0}, {"source": "readme_scrape_catalog_py", "target": "readme_catalog_json", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "L165-168", "weight": 1.0}, {"source": "readme_polite_scraping", "target": "readme_scrape_catalog_py", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L170-173", "weight": 1.0}, {"source": "readme_refresh_catalog_py", "target": "readme_vegapull_records", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L183-185", "weight": 1.0}, {"source": "readme_refresh_catalog_py", "target": "readme_catalog_json", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "L183-185,L241", "weight": 1.0}, {"source": "readme_refresh_catalog_py", "target": "readme_scrape_catalog_py", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": "L163-185", "weight": 1.0}, {"source": "readme_catalogue_co