# Copy to .env (which git ignores) and fill in. docker-compose.prod.yml reads it.

# ---- required ---------------------------------------------------------------

# The domain this runs at. Point its DNS A/AAAA record at the VPS first: Caddy
# fetches the HTTPS certificate for it on first start.
MANIFEST_DOMAIN=manifest.example.com

# Long random strings. `openssl rand -hex 24` makes a good one.
POSTGRES_PASSWORD=
MANIFEST_OBJECT_STORAGE_SECRET_KEY=

# ---- getting in -------------------------------------------------------------

# A shared code people quote to sign up (at least 16 characters in Production).
# Leave unset to close sign-up; then make accounts on the server with
#   docker compose -f docker-compose.prod.yml exec app manifest-entrypoint user add <name>
MANIFEST_INVITE_CODE=

# Or let people ask: requests are mailed here, and approved ones get a sign-up
# link. Needs the SMTP settings below.
MANIFEST_ADMIN_EMAIL=

# ---- mail (needed for MANIFEST_ADMIN_EMAIL) -----------------------------------
MANIFEST_SMTP_HOST=
MANIFEST_SMTP_PORT=587
MANIFEST_SMTP_USER=
MANIFEST_SMTP_PASSWORD=
MANIFEST_SMTP_FROM=

# ---- optional -----------------------------------------------------------------

# How many site containers and workers to run.
APP_REPLICAS=2
WORKER_REPLICAS=1

# Refresh market prices (and the catalogue) on a schedule; unset means never.
MANIFEST_REFRESH_PRICES_HOURS=24
#MANIFEST_REFRESH_CATALOG_HOURS=168

# A hosted bucket instead of the bundled s3 service (then remove that service):
#MANIFEST_OBJECT_STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#MANIFEST_OBJECT_STORAGE_BUCKET=manifest-art
#MANIFEST_OBJECT_STORAGE_ACCESS_KEY=
#MANIFEST_OBJECT_STORAGE_REGION=auto

# Paid OCR fallback for photos tesseract cannot read.
#ANTHROPIC_API_KEY=

# Different ports for Caddy, e.g. when trying this on a machine already using 80/443.
#HTTP_PORT=80
#HTTPS_PORT=443
